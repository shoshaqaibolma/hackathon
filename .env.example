# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Prisma 7 does not auto-load env files — prisma.config.ts loads .env.local
# explicitly via Node's built-in loader.
#
# DEMO mode (/demo) needs NONE of these. It reads recorded fixtures from disk.

# --- Database (Neon) -------------------------------------------------------
# Needed for FREE and BYOK scans, not for DEMO.
# Pooled connection, used by the app at runtime. Hostname contains "-pooler"."postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=
# Unpooled connection, used by `prisma migrate` and `prisma db push` only.
# Migrations through a pooler are unreliable.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Public panel (free tiers) ---------------------------------------------
# These power FREE mode for public visitors. Two providers, two model
# families, so panel agreement is real evidence rather than one lineage
# agreeing with itself.

# Google AI Studio — Gemini 3.8 Flash. Also the adjudicator for FREE/DEMO.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Groq — Qwen 3.8 27B. Free tier is ~30 RPM / 6,000 TPM / 1,000 RPD, which
# is why token-heavy work is routed to Gemini and Groq gets short answers.
# https://console.groq.com/keys
GROQ_API_KEY=""

# --- Search (the BROWSING condition) ---------------------------------------
# We run retrieval ourselves rather than using provider-native grounding, so
# every snippet the model saw is stored and shown in the UI.
# Without this, browsing reports itself as unavailable rather than silently
# behaving like the memory condition.
# https://app.tavily.com
TAVILY_API_KEY=""

# --- BYOK (optional) -------------------------------------------------------
# BYOK users supply their own key per request; it is never stored and these
# variables are NOT required for that. Set one only if you want the server
# itself to be able to use that provider.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Override the default model chosen for a BYOK provider.
# BYOK_ANTHROPIC_MODEL="claude-sonnet-5"
# BYOK_OPENAI_MODEL="gpt-5"

# --- Tuning (optional) -----------------------------------------------------
# Bump to invalidate every cached model response at once.
# LLM_CACHE_NAMESPACE="v1"
