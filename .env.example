# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Prisma 7 does not auto-load env files — prisma.config.ts loads .env.local
# explicitly via Node's built-in loader.

# --- Database (Neon) -------------------------------------------------------
# Pooled connection, used by the app at runtime. Hostname contains "-pooler".
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Unpooled connection, used by `prisma migrate` and `prisma db push` only.
# Migrations through a pooler are unreliable.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Models ----------------------------------------------------------------
ANTHROPIC_API_KEY=""

# Optional. Overrides the adjudication model; set to claude-sonnet-5 to cut a
# cold scan from roughly $9.30 to $3.30.
# ADJUDICATOR_MODEL="claude-sonnet-5"

# Optional. Adds a third, cross-provider model to the panel under test.
# Requires OPENAI_API_KEY. Leave unset for the default Anthropic-only panel.
# PANEL_OPENAI_MODEL=""
# OPENAI_API_KEY=""

# Optional. Bump to invalidate every cached model response at once.
# LLM_CACHE_NAMESPACE="v1"
